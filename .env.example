# ---------- Server ----------
NODE_ENV=development
PORT=4000
# MongoDB Atlas free tier (M0) connection string, or local mongodb://127.0.0.1:27017/personal-tracker
MONGODB_URI=mongodb://127.0.0.1:27017/personal-tracker
# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7
# URL of the web app (used for CORS and password-reset links)
CLIENT_URL=http://localhost:5173
# Where uploaded receipts/documents are stored when Google Drive is not connected
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---------- Email (optional: daily reminder email + password reset) — see docs/NOTIFICATIONS.md ----------
# If SMTP_HOST is empty, reset links are printed to the server console and the daily email is unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Personal Tracker <no-reply@example.com>"

# ---------- Google Calendar & Drive (optional) — see docs/GOOGLE_SETUP.md ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorised redirect URI" on your Google OAuth client
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback
# Optional: separate key for encrypting stored Google tokens (defaults to one derived from JWT_SECRET)
TOKEN_ENCRYPTION_KEY=

# ---------- Distance & travel (optional) ----------
# Free OpenStreetMap services are used by default (no key). Set ORS_API_KEY to use OpenRouteService instead
# (free key at openrouteservice.org, 2,000 requests/day). You can also point at your own Nominatim/OSRM servers.
ORS_API_KEY=
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org

# ---------- Phone/computer notifications (optional) ----------
# Leave empty: keys are generated automatically and stored in the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
